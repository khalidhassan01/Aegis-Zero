+def _header(resp: Any, name: str) -> str:
+    """Read a response header without assuming a rich headers object."""
+    headers = getattr(resp, "headers", None)
+    if headers is None:
+        return ""
+    try:
+        value = headers.get(name)
+    except AttributeError:
+        return ""
+    return str(value) if value is not None else ""
+
+
+def _retry_after_seconds(resp: Any) -> float | None:
+    """Best-effort parse of rate-limit hints: Retry-After (seconds or
+    HTTP-date), then X-RateLimit-Reset (epoch or delay). None = unknown."""
+    import email.utils
+    import time as _time
+
+    def _seconds_or_date(raw: str) -> float | None:
+        raw = raw.strip()
+        if not raw:
+            return None
+        try:
+            return max(float(raw), 0.0)
+        except ValueError:
+            pass
+        try:
+            when = email.utils.parsedate_to_datetime(raw)
+            return max((when.timestamp() - _time.time()), 0.0)
+        except (ValueError, TypeError, OverflowError):
+            return None
+
+    for name in ("retry-after", "x-ratelimit-reset"):
+        hint = _seconds_or_date(_header(resp, name))
+        if hint is not None:
+            # X-RateLimit-Reset is often an epoch timestamp, not a delay.
+            if name == "x-ratelimit-reset" and hint > 1_000_000:
+                return max(hint - _time.time(), 0.0)
+            return hint
+    return None
+
+
