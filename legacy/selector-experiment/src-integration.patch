+@dataclass(frozen=True, slots=True)
+class SelectorSettings:
+    """Automatic model selector (``provider.kind: selector``).
+
+    Defaults keep every path inside the user's own config/state/cache
+    areas, so a stock install writes nothing outside them. Paths go
+    through ``expanduser`` at use sites, so ``~`` works in YAML.
+    """
+
+    #: Key pool file: one section per provider, plus custom endpoints.
+    keys_file: str = "~/.config/aegis-zero/keys.yaml"
+    #: Also route to pay-per-token providers (off: free tier only).
+    allow_paid: bool = False
+    #: Where per-(key, model) learning evidence persists across restarts.
+    state_path: str = "~/.local/state/aegis-zero/selector/learning.json"
+    #: Optional user benchmark overrides (same shape as the seed table).
+    benchmarks_file: str = "~/.config/aegis-zero/benchmarks.yaml"
+    #: Exact model ids tried first when healthy (routing still applies).
+    preferred: tuple[str, ...] = ()
+    #: Exact ids or prefixes never routed to (e.g. a provider you dislike).
+    excluded: tuple[str, ...] = ()
+    #: Candidate ladder depth per request (models, before key rotation).
+    max_candidates: int = 8
+    #: Total wait budget when everything is rate limited at once.
+    patience_s: float = 120.0
+    #: Per-key request spacing so bursts cannot self-inflict a 429.
+    min_request_gap_s: float = 1.0
+    #: Fetch the live model catalog on first use (needs network once).
+    refresh_on_start: bool = True
+    #: Disk cache of the last live catalog fetch.
+    cache_path: str = "~/.cache/aegis-zero/selector/catalog.json"
+    #: How long that cache stays fresh.
+    cache_ttl_hours: float = 24.0
+    #: Embedding fallback when the free pool has no embedder (it rarely
+    #: does): a local OpenAI-compatible endpoint.
+    embed_fallback_base_url: str = "http://127.0.0.1:8001/v1"
+    embed_fallback_model: str = "nomic-embed-text"
+
+
