# Aegis Zero - Git Ignore
# Repository: https://github.com/khalidhassan01/Aegis-Zero

# Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
.codex
*.pyc

# Logs and databases
*.log
*.sqlite
*.db

# Local configuration
.env.local
.env.*.local

# Cache files
*.cache
.cache/

# Node (if used for documentation)
node_modules/

# Docker
.docker/

# Build artifacts
*.exe
*.dll

# Security and credentials
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore

# Data files
*.csv
*.json
*.xml
# …except the demo video manifest and the brand kit manifest,
# shipped and test-pinned assets
!docs/demo.video.json
!docs/brand/brand.assets.json

# Temporary files
*.tmp
*.temp

# Documentation build
_docs/
.docs/

# Test results
.test_results/
.pytest_cache/
.coverage

# v2 build artifacts
dist/
build/
*.egg-info/
.venv/
uv.lock
# uv's cache: git skips it via CACHEDIR.TAG, but hatchling does not honor
# that convention and would leak it into the sdist — ignore it explicitly
.uvcache/
.coverage
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
trace.jsonl
